<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Compteur.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <TextBlock Text="Compteur de clics" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <Button x:Name="BoutonAjouter" AutomationProperties.AutomationId="BoutonAjouter"
                Click="BoutonAjouter_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="16" />
                <TextBlock Text="Ajouter" />
            </StackPanel>
        </Button>
        <TextBlock x:Name="TexteCompteur" AutomationProperties.AutomationId="TexteCompteur"
                   HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
    </StackPanel>
</Page>
